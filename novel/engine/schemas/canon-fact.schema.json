{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonFact",
  "type": "object",
  "required": [
    "id",
    "subject",
    "predicate",
    "value",
    "status",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "value": {},
    "status": {
      "enum": [
        "LOCKED",
        "WORKING",
        "PENDING",
        "SUPERSEDED",
        "FICTIONALIZED"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}