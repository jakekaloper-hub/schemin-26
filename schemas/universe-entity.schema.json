{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/universe-entity.schema.json",
  "title": "Universe Entity V2",
  "type": "object",
  "required": [
    "entity_id",
    "name",
    "entity_type",
    "canon_state",
    "canon_confidence",
    "current_status"
  ],
  "properties": {
    "entity_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "PRINCIPAL",
        "PEOPLED_KIND",
        "SINGULAR_BEING",
        "COMMUNITY",
        "ORDER",
        "INSTITUTION",
        "LOCATION",
        "SETTLEMENT",
        "INFRASTRUCTURE",
        "ARTIFACT",
        "WEATHER_SYSTEM",
        "ENVIRONMENTAL_FORCE",
        "EVENT",
        "HISTORICAL_SITE",
        "JURISDICTION",
        "RUMOR",
        "MYTH",
        "MEMORIAL"
      ]
    },
    "canon_state": {
      "type": "string"
    },
    "canon_confidence": {
      "type": "object"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location_relationship": {
      "type": "object"
    },
    "temporal_state": {
      "type": "string"
    },
    "current_status": {
      "type": "string"
    },
    "population_model": {
      "type": "string"
    }
  }
}
