{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemin://story-production-graph/event_v1",
  "title": "Schemin Canonical Event Envelope V1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "league_time",
    "authority",
    "participants",
    "state",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-"
    },
    "event_type": {
      "enum": [
        "MATCHUP",
        "TRANSACTION",
        "DRAFT",
        "KEEPER",
        "INJURY",
        "PUBLICATION",
        "WORLD_CONSEQUENCE",
        "INSTITUTIONAL"
      ]
    },
    "league_time": {
      "type": "object",
      "required": [
        "season"
      ],
      "properties": {
        "season": {
          "type": "integer"
        },
        "week": {
          "type": [
            "integer",
            "null"
          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "source_receipts",
        "canon_status"
      ],
      "properties": {
        "evidence_status": {
          "enum": [
            "VERIFIED",
            "PROVISIONAL",
            "UNKNOWN"
          ]
        },
        "source_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "canon_status": {
          "enum": [
            "CANDIDATE",
            "BRANCHABLE",
            "ACCEPTED",
            "ARCHIVED"
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "CHARACTER",
              "TEAM",
              "PLAYER",
              "LOCATION",
              "ARTIFACT",
              "INSTITUTION"
            ]
          },
          "entity_id": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_state",
        "knowledge_cutoff"
      ],
      "properties": {
        "branch_state": {
          "enum": [
            "COMMON",
            "HOME_WIN",
            "AWAY_WIN",
            "SETTLED",
            "NOT_APPLICABLE"
          ]
        },
        "knowledge_cutoff": {
          "type": "string"
        },
        "world_writeback_allowed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
