{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemin://story-production-graph/memo_issue_v1",
  "title": "Schemin Memo Issue V1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "season",
    "week",
    "source_class",
    "publication_state",
    "authority_refs",
    "coverage_state",
    "binary_in_repo"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^MEMO-2026-W\\d{2}$"
    },
    "season": {
      "const": 2026
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18
    },
    "source_class": {
      "type": "string"
    },
    "publication_state": {
      "type": "string"
    },
    "canonical_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "coverage_state": {
      "type": "string"
    },
    "binary_in_repo": {
      "type": "boolean"
    }
  }
}
