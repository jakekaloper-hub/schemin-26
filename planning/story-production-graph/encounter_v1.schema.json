{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemin://story-production-graph/encounter_v1",
  "title": "Schemin Encounter Contract V1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "encounter_id",
    "event_id",
    "authority",
    "participants",
    "location",
    "persistent_scene_anchors",
    "shared_conditions",
    "scene_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "encounter_id": {
      "type": "string",
      "pattern": "^ENC-"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-"
    },
    "authority": {
      "type": "object",
      "required": [
        "source_receipts",
        "world_authority",
        "character_authority"
      ],
      "properties": {
        "source_receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "world_authority": {
          "type": "string"
        },
        "character_authority": {
          "type": "string"
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": "object",
      "required": [
        "location_id",
        "entering_state_receipt"
      ],
      "properties": {
        "location_id": {
          "type": "string"
        },
        "entering_state_receipt": {
          "type": "string"
        }
      }
    },
    "persistent_scene_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "shared_conditions": {
      "type": "object",
      "properties": {
        "weather": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_of_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "lighting": {
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scene_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SCN-"
      }
    },
    "branch_policy": {
      "type": "object",
      "properties": {
        "supports_outcome_branches": {
          "type": "boolean"
        },
        "settled_branch": {
          "enum": [
            "HOME_WIN",
            "AWAY_WIN",
            "SETTLED",
            "NOT_APPLICABLE",
            null
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
